{
  "uid": "faultline-anomaly",
  "title": "Anomaly Detection (Isolation Forest)",
  "tags": [
    "anomaly",
    "ml",
    "nginx"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m"
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "iconColor": "purple",
        "name": "Ground truth",
        "target": {
          "type": "tags",
          "tags": [
            "ground-truth"
          ],
          "matchAny": true,
          "limit": 500
        }
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "iconColor": "red",
        "name": "ML alert (Prometheus rule)",
        "expr": "ALERTS{alertname=\"MLAnomalyDetected\",alertstate=\"firing\"}",
        "step": "15s",
        "titleFormat": "MLAnomalyDetected",
        "useValueForTime": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "faultline-anomaly-panel",
      "title": "Isolation Forest \u2014 anomalies in nginx logs",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 13
      },
      "description": "Score vs threshold, debounced alerts (red), injected ground truth (purple), event-level quality, top deviating features. Click a band to zoom.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(nginx_anomaly_score)",
          "legendFormat": "__auto",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(nginx_anomaly_threshold)",
          "legendFormat": "__auto",
          "range": true,
          "instant": false
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(nginx_anomaly_alert)",
          "legendFormat": "__auto",
          "range": true,
          "instant": false
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(stand_ground_truth_anomaly_active) or vector(0)",
          "legendFormat": "__auto",
          "range": true,
          "instant": false
        },
        {
          "refId": "E",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (feature) (nginx_anomaly_feature_zscore)",
          "legendFormat": "{{feature}}",
          "range": false,
          "instant": true
        },
        {
          "refId": "F",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "nginx_anomaly_model_info",
          "legendFormat": "__auto",
          "range": false,
          "instant": true
        }
      ],
      "options": {
        "refScore": "A",
        "refThreshold": "B",
        "refAlert": "C",
        "refGroundTruth": "D",
        "refZScore": "E",
        "refModelInfo": "F",
        "showStats": true,
        "showWhy": true,
        "topN": 5,
        "gtToleranceS": 45
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Feature z-scores (|z| > 3 is unusual)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (feature) (nginx_anomaly_feature_zscore)",
          "legendFormat": "{{feature}}",
          "range": true,
          "instant": false
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Key features of the scored window",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (feature) (nginx_anomaly_feature_value{feature=~\"ratio_5xx|ratio_404|ratio_4xx\"})",
          "legendFormat": "{{feature}}",
          "range": true,
          "instant": false
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Latency features",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (feature) (nginx_anomaly_feature_value{feature=~\"rt_p95_ms|upstream_rt_p95_ms|rt_p50_ms\"})",
          "legendFormat": "{{feature}}",
          "range": true,
          "instant": false
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Detector health",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(nginx_anomaly_log_lines_total[$__rate_interval]))",
          "legendFormat": "lines/s",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(nginx_anomaly_parse_errors_total[$__rate_interval]))",
          "legendFormat": "parse errors/s",
          "range": true,
          "instant": false
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "time() - max(nginx_anomaly_last_window_timestamp_seconds)",
          "legendFormat": "seconds since last window",
          "range": true,
          "instant": false
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(nginx_anomaly_training_in_progress)",
          "legendFormat": "training",
          "range": true,
          "instant": false
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 22,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    }
  ]
}